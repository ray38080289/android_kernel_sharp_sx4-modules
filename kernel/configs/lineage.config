# Core options the MediaTek fragments turn off but the GKI kernel the
# modules load into (android15-6.6) has enabled; they change struct layouts.
CONFIG_ARM64_HW_AFDBM=y
CONFIG_PM_DEBUG=y
CONFIG_XFRM_MIGRATE=y

# Not shipped on sx4
# CONFIG_DEVICE_MODULES_STMMAC_ETH is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set
